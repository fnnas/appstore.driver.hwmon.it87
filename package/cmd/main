#!/bin/bash

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=package/cmd/common
. "${SCRIPT_DIR}/common"

PACKAGE_BASE=${TRIM_APPDEST}
MODULE_ROOT=/lib/modules
supportKernelList=("6.12.18-trim" "6.18.6-trim" "6.18.18-trim" "6.18.18.c788-trim")

nowKernelVer=$(uname -r)

kernel_build_num() {
    uname -v | sed -n 's/.*#\([0-9][0-9]*\).*/\1/p' | head -n 1
}

nowKernelBuildNum=$(kernel_build_num)

is_supported_kernel() {
    local kernel_ver=$1
    local supported_kernel

    for supported_kernel in "${supportKernelList[@]}"; do
        # shellcheck disable=SC2053
        if [[ "$kernel_ver" == $supported_kernel ]]; then
            return 0
        fi
    done

    return 1
}

ensure_supported_kernel() {
    local kernel_ver=$1

    if is_supported_kernel "$kernel_ver"; then
        echo "${kernel_ver} in supportKernelList"
        return 0
    fi

    echo "${kernel_ver} not in supportKernelList"
    echo "Supported versions: ${supportKernelList[*]}"
    exit 1
}

copy_module_payload() {
    local kernel_ver=$1
    local payload_dir=$2
    local target_dir="${MODULE_ROOT}/${kernel_ver}/updates/dkms/it87"

    mkdir -p "$target_dir"
    cp -rf "${PACKAGE_BASE}/app/${payload_dir}/"* "$target_dir/"
}

install_module_payload() {
    case "$nowKernelVer" in
        6.12.18-trim)
            copy_module_payload "6.12.18-trim" "ite-it87_6.12.18-trim_3"
            ;;
        6.18.6-trim)
            copy_module_payload "6.18.6-trim" "ite-it87_6.18.6-trim-297-amd64"
            ;;
        6.18.18-trim)
            if [[ ! "$nowKernelBuildNum" =~ ^[0-9]+$ ]]; then
                echo "Unsupported build number for ${nowKernelVer}: ${nowKernelBuildNum}"
                exit 1
            fi

            if (( nowKernelBuildNum < 570 )); then
                copy_module_payload "$nowKernelVer" "ite-it87_6.18.18-trim-427-amd64"
            elif (( nowKernelBuildNum >= 570 && nowKernelBuildNum < 587 )); then
                copy_module_payload "$nowKernelVer" "ite-it87_6.18.18-trim-570-amd64"
            elif (( nowKernelBuildNum >= 587 && nowKernelBuildNum < 717 )); then
                copy_module_payload "$nowKernelVer" "ite-it87_6.18.18-trim-587-amd64"
            else
                copy_module_payload "$nowKernelVer" "ite-it87_6.18.18-trim-717-amd64"
            fi
            ;;
        6.18.18.c788-trim)
            copy_module_payload "$nowKernelVer" "ite-it87_6.18.18.c788-trim-amd64"
            ;;
    esac
}

reload_it87() {
    modprobe -r -v it87 || echo "unload it87 failed"
    depmod
    modprobe -v it87 || echo "load it87 failed"
}

if [[ "${1:-}" != "status" ]]; then
    log_invocation "$@"
fi

case $1 in
start)
    ensure_supported_kernel "$nowKernelVer"
    install_module_payload
    reload_it87
    ;;
stop)
    :
    ;;
status)
    modlist=$(lsmod | grep -c it87)
    if [[ -d "/lib/modules/$(uname -r)/updates/dkms/it87" && $modlist -ne 0 ]]; then
        exit 0
    else
        log_invocation "$@"
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
